# Copy to /etc/latitude-zero.env  (root:root, chmod 600 — contains secrets).
# systemd reads this via EnvironmentFile=. NO quotes, NO `export`, one KEY=value per line.

SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Local Postgres created on the VPS (see DEPLOYMENT.md §VPS step 3):
DATABASE_URL=postgresql://latitude:REPLACE_DB_PASSWORD@127.0.0.1:5432/latitude_zero

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Production hardening — keep both true on a real server behind nginx+HTTPS:
COOKIE_SECURE=true
TRUST_PROXY=true
